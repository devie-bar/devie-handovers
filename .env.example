# Supabase: the shared De Vie Database project. Both have built-in defaults in
# lib/config.ts (the publishable key is safe to embed), so these are optional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is not used: the dashboard does not use it either,
# and every read and write here runs as the signed-in user under RLS.

# Square (server only). Read-only access to orders and catalog is enough.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=LG2QVCZ9QVCNC

# Slack (server only). The bot needs chat:write.
SLACK_BOT_TOKEN=
HANDOVERS_SLACK_CHANNEL=C07FN2USAJC
SLACK_TEST_CHANNEL=U072GTX5E3B
